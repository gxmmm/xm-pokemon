{
  "name": "pokemon-online",
  "version": "1.0.0",
  "private": true,
  "description": "friend co-op Pokemon raising game. ",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:worker": "wrangler dev",
    "dev": "concurrently -k -n web,worker -c magenta,cyan \"npm:dev:web\" \"npm:dev:worker\"",
    "build": "npm run build:web",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "typecheck": "vue-tsc -p apps/web/tsconfig.json --noEmit && tsc -p apps/worker/tsconfig.json --noEmit",
    "smoke": "node scripts/run.mjs smoke",
    "progress:browser": "node scripts/run.mjs progress-browser-report",
    "playable:browser": "node scripts/run.mjs playable-browser-report",
    "db:apply": "wrangler d1 execute pokemon-online --local --file=database/schema.sql",
    "db:apply:remote": "wrangler d1 execute pokemon-online --remote --file=database/schema.sql",
    "deploy": "npm run build && wrangler deploy",
    "deploy:db": "wrangler d1 execute pokemon-online --remote --file=database/schema.sql",
    "assets:download": "node scripts/download-sprites.mjs",
    "postinstall": "node scripts/check-env.mjs || true",
    "balance": "node scripts/run.mjs balance-report",
    "tactics": "node scripts/run.mjs tactics-report",
    "visuals:report": "node scripts/run.mjs visual-report",
    "visuals:battle": "node scripts/run.mjs battle-browser-report",
    "visuals:browser": "npm run build && node scripts/run.mjs visual-browser-report"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260905.1",
    "@types/node": "^22.9.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "concurrently": "^9.1.0",
    "esbuild": "^0.21.5",
    "playwright-core": "^1.61.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vue-tsc": "^2.1.10",
    "wrangler": "^4.129.0"
  },
  "engines": {
    "node": ">=18"
  }
}
